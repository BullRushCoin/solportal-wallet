# Copy to .env if you need local overrides. Do not commit .env.

# Shipped default is also in .grok/app-env.json. Leave false unless you are
# wiring real sign-in. The wallet sandbox does not require auth.
# VITE_AUTH_ENABLED=false

# Optional Postgres URL used only by the unused auth scaffold. Leave unset
# for local sandbox use (PGLite applies its own migrations).
# DATABASE_URL=

# Required only if you turn federated sign-in on in a Grok live preview
# (VITE_AUTH_ENABLED is not "false") and GROK_AUTH_CLIENT_SECRET is unset.
# Never commit the real value. A previous preview secret was hardcoded in
# src/lib/auth/preview.ts and remains in git history — treat it as exposed
# and rotate it on the auth broker if it is still valid.
# GROK_PREVIEW_CLIENT_SECRET=
# GROK_PREVIEW_CLIENT_ID=grok_preview

# Server-only. Powers live USD prices, token logos, 24h change, and the
# read-only "Watch an address" view via /api/market and /api/wallet.
# Never prefix this with VITE_ — that would expose it to the browser.
# Leave unset to fall back to the fixed demo prices in the client.
# HELIUS_API_KEY=

# Public fee-collection wallet. Safe to expose (it is a public key, not a secret).
# The USDC / SOL / PYUSD fee accounts shown in swap quotes are this address's
# associated token accounts. Defaults to GD5z4HJRrG6MTwrtceeu3W7mtHwZp7vBtQGkCHJrjJ2c.
# Either name works; VITE_ is visible in the client, which is intended.
# VITE_FEE_WALLET_ADDRESS=GD5z4HJRrG6MTwrtceeu3W7mtHwZp7vBtQGkCHJrjJ2c
# FEE_WALLET_ADDRESS=

# Platform fee on incinerator reclaimed SOL (rent + swap proceeds), in basis points.
# 500 = 5%. Safe to expose. Defaults to 500. Capped at 2000 (20%).
# VITE_INCINERATOR_FEE_BPS=500
# INCINERATOR_FEE_BPS=

# MoonPay publishable key (pk_test_ for sandbox). Publishable keys are safe in the client.
VITE_MOONPAY_PUBLISHABLE_KEY=
